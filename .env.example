# ==============================================================================
# SERVER-ONLY ENVIRONMENT VARIABLES
# WARNING: NEVER expose these credentials to browser code, HTML, client JS, git,
# or public configuration endpoints.
# ==============================================================================

# Groq LLM Inference (Server-only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# Request Limits & Timeouts
MAX_DOCUMENT_BYTES=500000
MAX_DOCUMENT_CHARS=120000
AI_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Judge Demo Authentication (Server-only)
DEMO_EMAIL=judge@example.com
DEMO_PASSWORD=change-this-demo-password
SESSION_SECRET=change-this-session-secret

# Google OAuth 2.0 (Server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/api/auth/google/callback

# Firebase Admin SDK (Server-only Private Credentials)
# Used exclusively by the server to securely connect to Cloud Firestore.
# NEVER confuse these with Firebase Web App configuration!
FIREBASE_PROJECT_ID=legallenz-ai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Contact Form & SMTP Service (Server-only)
CONTACT_TO_EMAIL=somansinghal06@gmail.com
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

