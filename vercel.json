{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/api",
      "dest": "api/index.js"
    },
    {
      "src": "/login",
      "dest": "public/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "public/dashboard.html"
    },
    {
      "src": "/contact",
      "dest": "public/contact.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
